# -- Build artifacts --------------------------------------------------
# NOTE: gitignore does NOT support inline comments - every comment must
# be on its own line (a trailing '#' becomes part of the pattern).
build/

# -- Compiled / derived objects --------------------------------------
*.o
*.elf
*.rel
*.bin

# -- Firmware images (contain proprietary stock data - NEVER commit) --
dump_firmware.bin
#   ^ 16 MB stock firmware dump
stock-ram.bin
#   ^ stock-firmware RAM-boot image (contains stock fw)
stock-ram-diag.bin
stock-spy.bin

# -- SD-card staging (generated by make sdcard; games/ holds local copies) --
sdcard/

# -- Tool build outputs (the .s/.c/.h/.json sources stay tracked) ----
# stockram shim + diag binaries
tools/stockram/*.bin
tools/stockram/*.o
# stock-spy payload build dir
tools/stock-spy/build/
# pack_reloc host tool - Linux binary
tools/pack_reloc/pack_reloc
# pack_reloc host tool - Windows binary
tools/pack_reloc/pack_reloc.exe
# ported menu + game outputs
tools/fpmain/*.bin
tools/fpmain/games-out/
tools/fpmain/.games-stamp
# libc_server test-loop runtime dir (doom1.wad, locally provisioned)
tools/libc_server/workdir/

# -- Linux host-tool builds (the .exe versions in these dirs are tracked) --
tools/spd_dump/spd_dump
tools/spd_dump/fphelper
tools/spd_dump/fphelper_t117
tools/spd_dump/unpac
tools/libc_server/libc_server

# -- Auto-cloned reference trees + logs ------------------------------
tools/rockbox-port/build.log*
# QEMU clone (UNC breaks meson - lives outside the repo)
tools/qemu-b310e/qemu-src/
# emulator evidence logs
tools/qemu-b310e/logs/

# -- SDK / reference caches (NEVER commit) ---------------------------
# leaked MOCOR vendor SDK (~1 GB, DMCA risk)
tools/mocor-zw217/
# hash-pinned SDK reference fetch cache
tools/dsp/reference/

# -- Samsung service manuals (proprietary/confidential - NEVER commit) --
docs/service_manual/

# -- Python ----------------------------------------------------------
__pycache__/

# -- Orchestrator session state (.omo/ - not published) --------------
.omo/

# -- AI-session knowledge files (kept on disk for local sessions) ----
AGENTS.md
arch/AGENTS.md
kernel/AGENTS.md
drivers/AGENTS.md
handoff.md

# -- Local tooling / machine-specific config -------------------------
# ghidra MCP server config (machine-specific paths)
opencode.json
# code intelligence index
.codegraph/

# -- Editor / OS noise -----------------------------------------------
*.swp
Thumbs.db
Desktop.ini
# literal file from make $(shell) `2>NUL` under a sh shell
NUL
